{
  "name": "kana-dojo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first hiragana and katakana trainer",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "vite build && tsc -p server/tsconfig.json",
    "start": "node server/dist/index.js",
    "strokes": "node scripts/build-strokes.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p web/tsconfig.json && tsc -p server/tsconfig.json --noEmit",
    "icons": "node scripts/build-icons.mjs",
    "e2e": "node tests/e2e/run.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^8.3.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.7",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright-core": "1.56",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
